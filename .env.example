# ============================================================================
# HirePanel settings. Copy this file to ".env" (or run: python scripts/setup_env.py)
# Every line is optional EXCEPT the two secrets when ENV=production.
# ============================================================================

# development = relaxed (no password, API docs on). production = locked down.
ENV=development

# ---- Secrets (setup_env.py generates these for you) -------------------------
# Password for the web app and API. Leave empty ONLY on your own laptop.
API_KEY=
# Shared secret between HirePanel and n8n.
WEBHOOK_SECRET=

# ---- FREE AI keys (no credit card needed) -----------------------------------
# Gemini: https://aistudio.google.com/apikey      Groq: https://console.groq.com/keys
# With NO keys the app still works using built-in offline rules.
# With BOTH keys, the two scorers run on two different providers (more independent opinions).
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional extras. OpenRouter needs a model id that ends in ":free". Ollama = a model on your own machine.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://localhost:11434/v1

# "auto" picks a current model your key can use. Or pin one, e.g. GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL=auto
GROQ_MODEL=auto

# Order the app tries providers in (it falls back to the next one on errors/limits).
LLM_PROVIDERS=gemini,groq,openrouter,ollama

# Free tiers have limits. These are SAFE defaults that stop the app from hitting them.
# Raise them only if your provider dashboard shows higher limits for your key.
GEMINI_RPM=10
GEMINI_RPD=200
GROQ_RPM=25
GROQ_RPD=900
GROQ_TPM=7000
OPENROUTER_RPM=15
OPENROUTER_RPD=150

# ---- Hiring policy ----------------------------------------------------------
SHORTLIST_THRESHOLD=70      # score needed to be recommended
REVIEW_BAND=10              # scores within this many points BELOW the threshold go to a human
MIN_CONFIDENCE=0.55         # below this, a human must look
DISAGREEMENT_DELTA=0.25     # how far apart the two scorers may be before a tie-break
BLIND_MODE=true             # hide name, email, phone, links, pronouns, graduation years from the AI
REDACT_INSTITUTIONS=true    # hide university names from the AI (our ablation showed they leak prestige bias)
COMPANY_NAME=our team
RECRUITER_NAME=The Recruiting Team

# ---- Notifications ----------------------------------------------------------
# n8n webhook URL (see README, "Connect n8n"). Example: http://n8n:5678/webhook/hirepanel
N8N_WEBHOOK_URL=
# Zero-setup alternative: a Discord channel webhook URL.
DISCORD_WEBHOOK_URL=
# Where the review links in notifications point to (your public URL once deployed).
PUBLIC_BASE_URL=http://localhost:8000

# ---- Storage and limits -----------------------------------------------------
DATA_DIR=./data
# Empty = SQLite file in DATA_DIR. For hosting use a free Postgres URL (Neon / Supabase).
DATABASE_URL=
MAX_UPLOAD_MB=5
RATE_LIMIT_PER_MIN=120
MAX_CONCURRENT_RUNS=2
RUN_TIMEOUT_S=300
# Automatically delete candidates after N days (0 = keep forever). Good privacy practice.
RETENTION_DAYS=0
# Comma separated origins allowed to call the API from another website (usually leave empty).
CORS_ORIGINS=
# Cache identical AI calls on disk (handy while developing, saves free quota).
LLM_CACHE=false
# Also ask an AI to double-check the AI's own writing for bias (uses extra quota).
BIAS_LLM=false

# --- research switches (leave these alone in real use; docs/RESULTS.md explains the experiments) ---
VERIFIER_ENABLED=true       # false = trust the AI's quotes blindly (experiment only)
SCORER_MODE=dual            # dual | a | b  (single-scorer experiment)
SHIELD_ENABLED=true         # false = skip prompt-injection / stuffing defences (experiment only)

# --- public demo (for a hosted portfolio link) ---
# true = anyone can READ jobs and candidates without the key (names shown as initials). Writes, exports and
# webhooks still need the key. ONLY use this on a deployment that holds fake data, never real candidates.
DEMO_MODE=false
