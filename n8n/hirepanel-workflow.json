{
  "name": "HirePanel: notify recruiter and email candidates",
  "nodes": [
    {
      "parameters": {
        "content": "## HirePanel hand-off\n\n**Top path** (event = candidate_decided): posts a short message to your Discord channel so the recruiter can open the review link.\n\n**Bottom path** (event = send_candidate_email): runs ONLY after a recruiter clicked *Approve* in HirePanel. Pick your SMTP credential on the email node (Gmail app password works).\n\nSet these in n8n's environment: DISCORD_WEBHOOK_URL, MAIL_FROM.",
        "height": 280,
        "width": 420,
        "color": 4
      },
      "id": "a1f0c0de-0000-4000-8000-000000000001",
      "name": "Read me",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-80, -140]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "hirepanel",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "a1f0c0de-0000-4000-8000-000000000002",
      "name": "HirePanel event",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [400, 160],
      "webhookId": "7b5a3a52-7d6f-4f0e-9a43-2f1d3f6b9c01"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.body.event }}",
              "rightValue": "send_candidate_email",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1f0c0de-0000-4000-8000-000000000003",
      "name": "Recruiter approved an email?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [640, 160]
    },
    {
      "parameters": {
        "jsCode": "const b = $input.first().json.body || {};\nconst icon = { shortlist: '🟢', human_review: '🟡', reject: '🔴' }[b.decision] || '⚪';\nconst label = { shortlist: 'Shortlist', human_review: 'Needs your review', reject: 'Not a fit' }[b.decision] || b.decision;\nconst lines = [\n  `${icon} **${b.candidate_name || 'A candidate'}** for **${b.job_title}**: ${b.score}/100 (${label}, confidence ${Math.round((b.confidence || 0) * 100)}%)`,\n  b.summary || '',\n];\nif (b.problems && b.problems.length) lines.push('Look at: ' + b.problems.join(' | '));\nlines.push(`Review: ${b.review_url}`);\nreturn [{ json: { text: lines.join('\\n').slice(0, 1900) } }];"
      },
      "id": "a1f0c0de-0000-4000-8000-000000000004",
      "name": "Write recruiter message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 260]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DISCORD_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ content: $json.text }) }}",
        "options": {}
      },
      "id": "a1f0c0de-0000-4000-8000-000000000005",
      "name": "Post to Discord",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1140, 260],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.MAIL_FROM }}",
        "toEmail": "={{ $('HirePanel event').item.json.body.to }}",
        "subject": "={{ $('HirePanel event').item.json.body.subject }}",
        "emailFormat": "text",
        "text": "={{ $('HirePanel event').item.json.body.body }}",
        "options": {}
      },
      "id": "a1f0c0de-0000-4000-8000-000000000006",
      "name": "Email the candidate",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [900, 60]
    }
  ],
  "connections": {
    "HirePanel event": {
      "main": [[{ "node": "Recruiter approved an email?", "type": "main", "index": 0 }]]
    },
    "Recruiter approved an email?": {
      "main": [
        [{ "node": "Email the candidate", "type": "main", "index": 0 }],
        [{ "node": "Write recruiter message", "type": "main", "index": 0 }]
      ]
    },
    "Write recruiter message": {
      "main": [[{ "node": "Post to Discord", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
